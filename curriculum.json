{
  "program": {
    "title": "Python + AI Software Engineering: Autonomous MarketingOps",
    "duration": "36 weeks",
    "study_days": 216,
    "daily_minutes": 90,
    "checkpoint": "Weeks 1 and 2 complete; Week 3 Day 1 in progress at bounded range practice",
    "capstone": "Autonomous AI Marketing Operations Agent with deterministic KPIs, validated AI recommendations, policy-controlled adapters, human approval, evidence, and outcome measurement",
    "daily_routine": [
      {"minutes": 15, "activity": "Retrieve prior concepts and predict behavior"},
      {"minutes": 25, "activity": "Learn one focused programming concept"},
      {"minutes": 40, "activity": "Write and test the student implementation"},
      {"minutes": 10, "activity": "Review failures, design, evidence, and Git diff"}
    ],
    "evidence_checklist": [
      "Explain the concept without notes",
      "Implement it without copying",
      "Test normal, boundary, malformed, and denied behavior",
      "Explain one failure and its fix",
      "Identify trust and side-effect boundaries",
      "Connect the capability to MarketingOps AI"
    ],
    "architecture_rule": "AI proposes; deterministic code validates; policy authorizes; a human approves when required; a deterministic adapter executes; evidence records the outcome",
    "source_policy": {
      "label": "Primary technical documentation",
      "allowed_domains": ["docs.python.org", "www.gnu.org", "learn.microsoft.com", "git-scm.com", "docs.github.com", "developer.mozilla.org"]
    }
  },
  "sources": {
    "python_tutorial": {"title": "Python Tutorial", "url": "https://docs.python.org/3/tutorial/"},
    "python_library": {"title": "Python Standard Library", "url": "https://docs.python.org/3/library/"},
    "python_security": {"title": "Python Security Considerations", "url": "https://docs.python.org/3/library/security_warnings.html"},
    "bash": {"title": "GNU Bash Reference Manual", "url": "https://www.gnu.org/software/bash/manual/bash.html"},
    "powershell": {"title": "Microsoft PowerShell Documentation", "url": "https://learn.microsoft.com/powershell/"},
    "git": {"title": "Pro Git", "url": "https://git-scm.com/book/en/v2"},
    "github": {"title": "GitHub Get Started", "url": "https://docs.github.com/en/get-started"},
    "http": {"title": "MDN HTTP Overview", "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Overview"}
  },
  "weekly_rotation": [
