    {"track": "Data and interfaces", "topic_group": "data", "objective": "Use {topic} with validated marketing data.", "sources": ["python_library", "http"], "practice": "Transform a local fixture using {topic} while preserving rejected-data evidence.", "deliverable": "A deterministic data transformation or interface contract."},
    {"track": "Reliable automation", "topic_group": "automation", "objective": "Build {topic} behind a safe deterministic boundary.", "sources": ["python_library", "python_security"], "practice": "Implement {topic} with timeouts, bounded work, useful errors, or dry-run where applicable.", "deliverable": "A reusable component and a negative test."},
    {"track": "Git and quality", "topic_group": "quality", "objective": "Practice {topic} on the current project.", "sources": ["git", "github"], "practice": "Inspect semantic and noise changes, test the intended snapshot, and document {topic}.", "deliverable": "A reviewed diff, focused test evidence, or small commit."},
    {"track": "Policy and reliability", "topic_group": "policy", "objective": "Apply {topic} as an explicit engineering constraint.", "sources": ["python_security", "python_library"], "practice": "Write deterministic rules and denied or failure cases for {topic}.", "deliverable": "An explainable decision record and tests."},
    {"track": "Integrated project", "topic_group": "project", "objective": "Integrate this week's skills into {topic}.", "sources": ["python_tutorial", "python_library", "git"], "practice": "Implement only the current vertical slice of {topic}; do not build future milestones.", "deliverable": "Student code, tests, documentation, and a focused Git review."},
